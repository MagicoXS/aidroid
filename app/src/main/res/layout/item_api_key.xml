<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_margin="6dp" app:cardBackgroundColor="@color/aui_card" app:cardCornerRadius="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/tvEmoji" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/tvName" android:textColor="@color/aui_yellow" android:textStyle="bold" android:paddingStart="6dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
        </LinearLayout>
        <EditText android:id="@+id/etKey" android:hint="الصق المفتاح" android:textColor="@color/aui_text" android:textColorHint="@color/aui_text_dim" android:textSize="12sp" android:inputType="textPassword" android:background="@color/aui_card_light" android:padding="10dp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:orientation="horizontal" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnTest" android:text="🧪" android:backgroundTint="@color/aui_blue" android:textColor="#FFFFFF" android:layout_weight="1" android:layout_marginEnd="3dp" android:layout_width="0dp" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnSave" android:text="💾" android:textColor="#0A0A0A" android:backgroundTint="@color/aui_yellow" android:layout_weight="1" android:layout_marginEnd="3dp" android:layout_width="0dp" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnDelete" android:text="🗑️" android:backgroundTint="@color/aui_red" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
